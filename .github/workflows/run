yaml
name: Daily update

on:
  schedule:
    - cron: '17 3 * * *' # Varje dag 03:17 UTC
  workflow_dispatch: # Gör det möjligt att starta manuellt

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  update-and-deploy:
    runs-on: ubuntu-latest

    environment:
      name: github-pages

    steps:
      - name: Hämta repository
        uses: actions/checkout@v6

      - name: Kör mitt script
        run: |
          python build.py

      - name: Förbered GitHub Pages
        uses: actions/configure-pages@v5

      - name: Ladda upp hemsidan
        uses: actions/upload-pages-artifact@v4
        with:
          path: ./public

      - name: Publicera till GitHub Pages
        uses: actions/deploy-pages@v4
